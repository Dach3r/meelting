PORT=3000

# Docker Compose (self-hosting)
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
MEELTING_DATABASE_PASSWORD=
# Set to true when a reverse proxy terminates TLS in front of the app
FORCE_SSL=false
APP_HOST=localhost

# Directory that holds the bare Git repositories (default: storage/repositories)
MEELTING_GIT_ROOT=
