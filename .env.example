PORT=3000

# Docker Compose (self-hosting)
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
MEELTING_DATABASE_PASSWORD=
# Set to true when a reverse proxy terminates TLS in front of the app
FORCE_SSL=false
APP_HOST=localhost

# Directory that holds the bare Git repositories (default: storage/repositories)
MEELTING_GIT_ROOT=

# Active Record Encryption (encrypts model API keys). Generate with: bin/rails db:encryption:init
# WARNING: keep these values safe and backed up. If they are lost or changed, every stored
# model key becomes unrecoverable and users must add their keys again.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
