<% content_for :title, t("placeholders.settings.title") %>
<% content_for :main_class, "flex w-full flex-col" %>
<%= render Molecules::PageHeader::Component.new(title: t("placeholders.settings.title"), subtitle: t("placeholders.settings.subtitle", name: Current.user.full_name, username: Current.user.username), initial: Current.user.initials.first, class: "mb-10") %>

<div class="flex w-full max-w-[760px] flex-col gap-6">
  <% if notice %>
    <%= render Molecules::Notice::Component.new(tone: :notice, id: "notice") do %><%= notice %><% end %>
  <% end %>
  <ul class="m-0 flex list-none flex-col border-t border-line p-0">
    <li class="border-b border-line">
      <%= link_to access_tokens_path, class: "flex items-center gap-4 py-5 text-ink" do %>
        <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-lime text-forest" aria-hidden="true"><%= render Atoms::Icon::Component.new(name: :key_round, class: "size-[18px]", "stroke-width": 2) %></span>
        <span class="flex-1 text-[17px] font-bold"><%= t("placeholders.settings.access_tokens") %></span>
        <%= render Atoms::Icon::Component.new(name: :chevron_right, class: "size-[18px] text-forest", "stroke-width": 2) %>
      <% end %>
    </li>
    <li class="flex flex-wrap items-center gap-4 border-b border-line py-5" id="model_keys">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-lime text-forest" aria-hidden="true"><%= render Atoms::Icon::Component.new(name: :bot, class: "size-[18px]", "stroke-width": 2) %></span>
      <div class="flex min-w-0 flex-[1_1_240px] flex-col gap-0.5">
        <span class="text-[17px] font-bold"><%= t("placeholders.settings.model_keys") %></span>
        <span class="text-sm text-forest">
          <%= @provider_credential ? t("provider_credentials.status.#{@provider_credential.status}", provider: t("provider_credentials.providers.#{@provider_credential.provider}")) : t("provider_credentials.status.none") %>
        </span>
        <% if @provider_credential&.status_unverified? %>
          <span class="text-sm font-semibold text-danger" role="status"><%= t("provider_credentials.unverified_notice") %></span>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <% action = if @provider_credential.nil? then :add elsif @provider_credential.status_unverified? then :retry else :replace end %>
        <%= render Atoms::LinkButton::Component.new(href: new_provider_credential_path, variant: :secondary, size: :sm) do %><%= t("provider_credentials.actions.#{action}") %><% end %>
        <% if @provider_credential %>
          <%= button_to t("provider_credentials.actions.remove"), provider_credential_path(@provider_credential), method: :delete, class: "nb-btn h-10 bg-transparent px-3.5 text-sm text-danger hover:bg-danger-soft" %>
        <% end %>
      </div>
    </li>
    <li class="flex flex-wrap items-center gap-4 border-b border-line py-5">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-cream text-forest" aria-hidden="true"><%= render Atoms::Icon::Component.new(name: :refresh_cw, class: "size-[18px]", "stroke-width": 2) %></span>
      <span class="flex-1 text-[17px] font-bold"><%= t("placeholders.settings.mirrors") %></span>
      <%= render Atoms::Chip::Component.new do %><%= t("placeholders.phase_short", phase: 1) %><% end %>
    </li>
  </ul>
</div>
