<% content_for :title, t(".title") %>
<% content_for :main_class, "flex w-full flex-col" %>
<%= render Molecules::PageHeader::Component.new(title: t(".title"), subtitle: t(".lead"), icon: :bot, class: "mb-10") %>

<%= form_with model: @provider_credential, url: provider_credentials_path, method: :post, class: "flex w-full max-w-[600px] flex-col gap-6" do |form| %>
  <% if @provider_credential.errors.any? %>
    <%= render Molecules::Notice::Component.new(tone: :alert, id: "error_explanation") do %>
      <%= @provider_credential.errors.full_messages.to_sentence %>
    <% end %>
  <% end %>

  <%= render Molecules::FormField::Component.new(form: form, attribute: :api_key, label: t(".api_key"), icon: :key_round, type: :password, value: nil, placeholder: t(".api_key_placeholder")) do |field| %>
    <% field.with_status do %><p class="text-sm text-muted"><%= t(".hint") %></p><% end %>
  <% end %>

  <%= render Atoms::SubmitButton::Component.new do %><%= t(".submit") %><% end %>
<% end %>
