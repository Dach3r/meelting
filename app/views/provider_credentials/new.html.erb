<% content_for :title, t(".title") %>
<div class="flex w-full max-w-xl flex-col gap-6">
  <div>
    <h1 class="mb-2 text-[32px] font-extrabold leading-none tracking-[-0.04em]"><%= t(".title") %></h1>
    <p class="text-graphite-500"><%= t(".lead") %></p>
  </div>

  <%= form_with model: @provider_credential, url: provider_credentials_path, method: :post, class: "flex flex-col gap-5" do |form| %>
    <% if @provider_credential.errors.any? %>
      <%= render Molecules::Notice::Component.new(tone: :alert, id: "error_explanation") do %>
        <%= @provider_credential.errors.full_messages.to_sentence %>
      <% end %>
    <% end %>

    <%= render Molecules::FormField::Component.new(form: form, attribute: :api_key, label: t(".api_key"), icon: :lock, type: :password, value: nil, autocomplete: "off", placeholder: t(".api_key_placeholder")) %>
    <p class="-mt-3 pl-1 text-sm text-graphite-500"><%= t(".hint") %></p>

    <%= render Atoms::SubmitButton::Component.new do %><%= t(".submit") %><% end %>
  <% end %>
</div>
