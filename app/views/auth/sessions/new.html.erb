<div class="nb-card mx-auto w-full bg-white p-6 md:w-2/3 md:p-8">
  <% if alert = flash[:alert] %>
    <p class="nb-card mb-5 bg-coral-100 px-4 py-2.5 font-bold text-coral-700" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="nb-card mb-5 bg-sky-100 px-4 py-2.5 font-bold text-sky-700" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="text-4xl font-extrabold tracking-tight">Sign in</h1>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.text_field :username, required: true, autofocus: true, autocapitalize: "none", autocomplete: "username", placeholder: "Enter your username", value: params[:username], class: "nb-field" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "nb-field" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit "Sign in", class: "nb-btn nb-btn-raised bg-brand-600 px-5 py-3 text-white hover:bg-brand-700 w-full sm:w-auto" %>
      </div>

      <div class="mt-4 text-sm text-ink-soft sm:mt-0">
        <%= link_to "Forgot password?", new_password_path, class: "font-bold text-brand-600 underline hover:no-underline" %>
        &middot;
        <%= link_to "Sign up", new_registration_path, class: "font-bold text-brand-600 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
