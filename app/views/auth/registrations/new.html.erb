<% content_for :title, t(".title") %>

<%= render Molecules::AuthHeading::Component.new(title: t(".title"), description: t(".description")) %>

<%= form_with model: @user, url: registration_path, class: "mt-6 grid grid-cols-1 gap-4" do |form| %>
  <% if @user.errors.any? %>
    <%= render Molecules::Notice::Component.new(tone: :alert, id: "error_explanation", class: "mb-0") do %>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render Molecules::FormField::Component.new(form: form, attribute: :username, label: t("auth.fields.username"), icon: :user, autofocus: true, autocapitalize: "none", autocomplete: "username", placeholder: t(".username_placeholder")) %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= render Molecules::FormField::Component.new(form: form, attribute: :first_name, label: t("auth.fields.first_name"), icon: :user, autocomplete: "given-name", placeholder: t(".first_name_placeholder")) %>
    <%= render Molecules::FormField::Component.new(form: form, attribute: :last_name, label: t("auth.fields.last_name"), icon: :user, autocomplete: "family-name", placeholder: t(".last_name_placeholder")) %>
  </div>

  <%= render Molecules::FormField::Component.new(form: form, attribute: :email_address, label: t("auth.fields.email_address"), icon: :mail, type: :email, autocomplete: "email", placeholder: t(".email_address_placeholder")) %>
  <%= render Molecules::FormField::Component.new(form: form, attribute: :password, label: t("auth.fields.password"), icon: :lock, type: :password, autocomplete: "new-password", placeholder: t(".password_placeholder"), maxlength: 72) %>

  <%= render Atoms::SubmitButton::Component.new(class: "mt-2") do %><%= t(".submit") %><% end %>

  <div class="flex flex-wrap items-center justify-center gap-x-2 text-sm text-brand-200">
    <%= t(".have_account") %>
    <%= render Atoms::Link::Component.new(href: new_session_path, tone: :signal) do %><%= t(".sign_in") %><% end %>
  </div>
<% end %>
