<% content_for :title, t(".title") %>

<%= render Molecules::AuthHeading::Component.new(title: t(".title"), description: t(".description")) %>

<%= form_with url: passwords_path, class: "mt-6 grid grid-cols-1 gap-4" do |form| %>
  <%= render Molecules::FormField::Component.new(form: form, attribute: :email_address, label: t("auth.fields.email_address"), icon: :mail, type: :email, autofocus: true, autocomplete: "username", placeholder: t(".email_address_placeholder"), value: params[:email_address]) %>

  <%= render Atoms::SubmitButton::Component.new(class: "mt-2") do %><%= t(".submit") %><% end %>

  <div class="text-center text-sm text-brand-200">
    <%= render Atoms::Link::Component.new(href: new_session_path, tone: :signal) do %><%= t(".back_to_sign_in") %><% end %>
  </div>
<% end %>
