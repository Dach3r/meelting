<% content_for :main_class, "flex w-full flex-col" %>
<%= render Molecules::PageHeader::Component.new(title: t(".title"), icon: :git_branch, class: "mb-10") do |header| %>
  <% header.with_aside do %>
    <%= render Atoms::LinkButton::Component.new(href: new_repository_path, variant: :primary, size: :md) do %><%= render Atoms::Icon::Component.new(name: :plus, class: "size-[18px]", "stroke-width": 2) %><%= t(".new") %><% end %>
  <% end %>
<% end %>

<div class="flex w-full max-w-[760px] flex-col gap-6">
  <% if notice = flash[:notice] %>
    <%= render Molecules::Notice::Component.new(tone: :notice, id: "notice") do %><%= notice %><% end %>
  <% end %>

  <% if @repositories.empty? %>
    <p class="border-t border-line pt-6 text-muted"><%= t(".empty") %></p>
  <% else %>
    <ul class="m-0 flex list-none flex-col border-t border-line p-0">
      <% @repositories.each do |repository| %>
        <li class="flex items-center gap-4 border-b border-line py-5" id="<%= dom_id(repository) %>">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-lime text-sm font-bold text-forest" aria-hidden="true"><%= repository.name[0].downcase %></span>
          <div class="flex min-w-0 flex-col gap-0.5">
            <p class="text-[17px] font-bold"><%= repository.name %> <span class="font-sans text-sm font-normal text-muted">&middot; <%= t("repositories.visibilities.#{repository.visibility}") %></span></p>
            <% if repository.description.present? %>
              <p class="text-sm text-muted"><%= repository.description %></p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
