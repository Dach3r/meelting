<% content_for :title, @path %>
<div class="flex w-full max-w-4xl flex-col gap-6">
  <%= render Molecules::PageHeader::Component.new(title: @path) %>
  <% if @license %>
    <%= render Molecules::LicenseSummary::Component.new(license: @license) %>
  <% end %>
  <% if @text %>
    <pre id="blob" class="overflow-x-auto rounded-lg border border-line p-4 font-mono text-sm leading-relaxed whitespace-pre"><%= @text %></pre>
  <% else %>
    <p id="blob_too_large" class="text-[15px] text-forest"><%= t(".too_large") %></p>
  <% end %>
</div>
