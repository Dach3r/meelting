<div class="nb-card mx-auto w-full bg-white p-6 md:w-2/3 md:p-8">
  <h1 class="text-4xl font-extrabold tracking-tight"><%= t(".title") %></h1>

  <%= form_with model: @repository, class: "contents" do |form| %>
    <% if @repository.errors.any? %>
      <div class="nb-card mt-5 bg-coral-100 px-4 py-2.5 font-bold text-coral-700" id="error_explanation">
        <ul>
          <% @repository.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% field_class = "nb-field" %>

    <div class="my-5">
      <%= form.label :name, class: "font-bold" %>
      <%= form.text_field :name, required: true, autofocus: true, class: field_class %>
    </div>

    <div class="my-5">
      <%= form.label :slug, class: "font-bold" %>
      <%= form.text_field :slug, required: true, autocapitalize: "none", class: field_class %>
      <p class="text-sm text-ink-soft mt-1"><%= t(".slug_hint") %></p>
    </div>

    <div class="my-5">
      <%= form.label :description, class: "font-bold" %>
      <%= form.text_area :description, rows: 3, maxlength: 350, class: field_class %>
    </div>

    <fieldset class="my-5">
      <legend class="font-bold"><%= Repository.human_attribute_name(:visibility) %></legend>
      <% Repository.visibilities.each_key do |visibility| %>
        <div class="mt-2">
          <%= form.radio_button :visibility, visibility, class: "accent-brand-600" %>
          <%= form.label "visibility_#{visibility}", t("repositories.visibilities.#{visibility}") %>
        </div>
      <% end %>
    </fieldset>

    <div class="my-5">
      <%= form.label :license_id, class: "font-bold" %>
      <%= form.collection_select :license_id, License.active.order(:name), :id, :name, { include_blank: t(".no_license") }, class: field_class %>
    </div>

    <div class="my-5">
      <%= form.label :default_branch, class: "font-bold" %>
      <%= form.text_field :default_branch, required: true, autocapitalize: "none", class: field_class %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit t(".submit"), class: "nb-btn nb-btn-raised bg-brand-600 px-5 py-3 text-white hover:bg-brand-700" %>
      <%= link_to t(".cancel"), repositories_path, class: "font-bold text-brand-600 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
