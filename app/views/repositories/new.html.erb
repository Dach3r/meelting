<% content_for :title, t(".title") %>

<%= form_with model: @repository, class: "grid w-full content-start gap-5",
      data: { controller: "repository-form", action: "input->repository-form#refresh",
              repository_form_url_template_value: repository_section_url("__slug__", :code), repository_form_taken_slugs_value: @taken_slugs } do |form| %>
  <h1 class="mb-1 text-[34px] leading-[1.05] font-extrabold tracking-[-0.02em]"><%= t(".title") %></h1>

  <% if @repository.errors.any? %>
    <div class="rounded-xl bg-danger-soft px-4 py-3 text-[15px] font-semibold text-danger" id="error_explanation" role="alert">
      <ul>
        <% @repository.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render Molecules::FormField::Component.new(form: form, attribute: :name, label: Repository.human_attribute_name(:name), icon: :type, autofocus: true, placeholder: t(".name_placeholder"), data: { repository_form_target: "name" }) do |field| %>
    <% field.with_label_aside do %><p class="min-w-0 truncate font-mono text-[13px] font-semibold" data-repository-form-target="url" aria-live="polite" hidden></p><% end %>
  <% end %>
  <fieldset class="min-w-0">
    <legend class="mb-2 pl-1 text-base leading-[normal] font-semibold text-forest"><%= Repository.human_attribute_name(:visibility) %></legend>
    <div class="flex flex-wrap gap-2.5">
      <% { private: :lock, public: :globe }.each do |visibility, icon| %>
        <label class="nb-choice">
          <%= form.radio_button :visibility, visibility, class: "sr-only" %>
          <span class="nb-field-shell-icon"><%= render Atoms::Icon::Component.new(name: icon, class: "size-[18px]") %></span>
          <span><%= t("repositories.visibilities.#{visibility}") %></span>
        </label>
      <% end %>
    </div>
  </fieldset>
  <div class="grid gap-5 sm:grid-cols-2 sm:gap-x-2.5">
    <%= render Molecules::FormField::Component.new(form: form, attribute: :license_id, label: Repository.human_attribute_name(:license_id), icon: :scale) do |field| %>
      <% field.with_control do %>
        <%= form.collection_select :license_id, License.active.order(:name), :id, :name, { include_blank: t(".no_license") }, class: "nb-field-shell-input" %>
        <%= render Atoms::Icon::Component.new(name: :chevron_down, class: "pointer-events-none size-4 flex-none", "stroke-width": 2.4) %>
      <% end %>
    <% end %>
    <%= render Molecules::FormField::Component.new(form: form, attribute: :default_branch, label: Repository.human_attribute_name(:default_branch), icon: :git_branch, autocapitalize: "none", class: "nb-field-shell-input font-mono") %>
  </div>
  <%= render Molecules::FormField::Component.new(form: form, attribute: :description, label: Repository.human_attribute_name(:description), icon: :align_left, type: :text_area, required: false, rows: 3, maxlength: 350, placeholder: t(".description_placeholder")) %>

  <div class="mt-1 flex justify-end">
    <button type="submit" class="flex h-16 cursor-pointer items-center gap-2 rounded-full bg-lime px-8 text-[17px] font-semibold text-forest hover:bg-lime-soft">
      <%= t(".submit") %>
      <%= render Atoms::Icon::Component.new(name: :arrow_right, class: "size-[18px]", "stroke-width": 2) %>
    </button>
  </div>
<% end %>
