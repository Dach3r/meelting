<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <%= form_with model: @repository, class: "contents" do |form| %>
    <% if @repository.errors.any? %>
      <div class="py-2 px-3 bg-red-50 mt-5 text-red-500 font-medium rounded-lg" id="error_explanation">
        <ul>
          <% @repository.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% field_class = "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>

    <div class="my-5">
      <%= form.label :name, class: "font-medium" %>
      <%= form.text_field :name, required: true, autofocus: true, class: field_class %>
    </div>

    <div class="my-5">
      <%= form.label :slug, class: "font-medium" %>
      <%= form.text_field :slug, required: true, autocapitalize: "none", class: field_class %>
      <p class="text-sm text-gray-500 mt-1"><%= t(".slug_hint") %></p>
    </div>

    <div class="my-5">
      <%= form.label :description, class: "font-medium" %>
      <%= form.text_area :description, rows: 3, maxlength: 350, class: field_class %>
    </div>

    <fieldset class="my-5">
      <legend class="font-medium"><%= Repository.human_attribute_name(:visibility) %></legend>
      <% Repository.visibilities.each_key do |visibility| %>
        <div class="mt-2">
          <%= form.radio_button :visibility, visibility %>
          <%= form.label "visibility_#{visibility}", t("repositories.visibilities.#{visibility}") %>
        </div>
      <% end %>
    </fieldset>

    <div class="my-5">
      <%= form.label :license_id, class: "font-medium" %>
      <%= form.collection_select :license_id, License.active.order(:name), :id, :name, { include_blank: t(".no_license") }, class: field_class %>
    </div>

    <div class="my-5">
      <%= form.label :default_branch, class: "font-medium" %>
      <%= form.text_field :default_branch, required: true, autocapitalize: "none", class: field_class %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit t(".submit"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= link_to t(".cancel"), repositories_path, class: "text-gray-700 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
