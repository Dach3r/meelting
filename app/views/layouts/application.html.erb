<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title><%= content_for(:title) || ApplicationHelper::CONFIG[:name] %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="<%= ApplicationHelper::CONFIG[:name] %>">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= content_for :head %>
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="preload" href="<%= asset_path("inter-latin-wght-normal.woff2") %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= asset_path("outfit-latin-700-normal.woff2") %>" as="font" type="font/woff2" crossorigin>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="<%= class_names("min-h-svh bg-white text-graphite-900", "flex flex-col px-5 pb-5" => !authenticated?) %>">
  <% if authenticated? %>
    <%= render Organisms::Sidebar::Component.new(workspace: workspace, expanded_slug: session[:expanded_repository]) %>
    <div class="flex min-h-svh flex-col px-5 pb-5 lg:ml-64">
      <%= render Organisms::Navbar::Component.new(authenticated: true, user: Current.user) %>
      <main class="<%= class_names("min-w-0 flex-1", content_for(:main_class) || "flex w-full pb-16") %>">
        <%= content_for?(:content) ? yield(:content) : yield %>
      </main>
    </div>
  <% else %>
    <%= render Organisms::Navbar::Component.new(authenticated: false) %>
    <main class="<%= content_for(:main_class) || "flex w-full pb-16 pl-5 pr-2" %>">
      <%= content_for?(:content) ? yield(:content) : yield %>
    </main>
  <% end %>
</body>
</html>
