<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title><%= content_for(:title) || ApplicationHelper::APP_NAME %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="<%= ApplicationHelper::APP_NAME %>">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= content_for :head %>
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="preload" href="<%= asset_path("inter-latin-wght-normal.woff2") %>" as="font" type="font/woff2" crossorigin>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<% if authenticated? %>
  <body class="group/shell min-h-svh bg-forest text-ink lg:h-svh lg:overflow-hidden lg:py-[22px]" <%= "data-sidebar-expanded" if sidebar_expanded? %>>
    <%= render Organisms::Sidebar::Component.new(workspace: workspace, user: Current.user, expanded_slug: session[:expanded_repository]) %>
    <div class="mx-3 mb-3 flex min-h-[calc(100svh-0.75rem)] flex-col gap-6 rounded-[28px] bg-cream p-4 sm:p-7 lg:my-0 lg:mr-[22px] lg:ml-23 lg:h-[calc(100svh-44px)] lg:min-h-0 lg:transition-[margin-left] lg:duration-200 lg:ease-out lg:group-data-sidebar-expanded/shell:ml-66 motion-reduce:transition-none">
      <%= render Organisms::Navbar::Component.new(authenticated: true) %>
      <main class="<%= class_names("min-w-0 flex-1 rounded-3xl bg-white p-6 sm:p-9 lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain", content_for(:main_class) || "flex w-full") %>">
        <%= content_for?(:content) ? yield(:content) : yield %>
      </main>
    </div>
  </body>
<% else %>
  <body class="flex min-h-svh flex-col bg-cream px-5 pb-5 text-ink">
    <%= render Organisms::Navbar::Component.new(authenticated: false) %>
    <main class="<%= content_for(:main_class) || "flex w-full pb-16 pl-5 pr-2" %>">
      <%= content_for?(:content) ? yield(:content) : yield %>
    </main>
  </body>
<% end %>
</html>
