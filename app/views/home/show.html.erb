<% content_for :title, t(".title") %>
<% content_for :main_class, "flex w-full flex-col" %>

<div class="<%= class_names("flex w-full flex-col gap-10", "flex-1" => workspace.no_repositories?) %>">
  <% if workspace.no_repositories? %>
    <section id="no_repositories" class="flex flex-1 flex-col items-center justify-center gap-[22px] p-5 text-center">
      <div class="mb-2 flex size-[260px] items-center justify-center rounded-full border-[1.5px] border-dashed border-cream-line" aria-hidden="true">
        <div class="flex size-[180px] items-center justify-center rounded-full border-[1.5px] border-dashed border-forest-soft">
          <span class="flex size-[104px] items-center justify-center rounded-[30px] bg-lime text-forest shadow-[0_0_80px_rgba(209,244,112,0.6)]"><%= render Atoms::Icon::Component.new(name: :folder_plus, class: "size-11", "stroke-width": 1.6) %></span>
        </div>
      </div>
      <h1 class="text-[44px] font-extrabold leading-[1.05] tracking-[-0.025em]"><%= t("home.no_repositories.title_html", accent: tag.span(t("home.no_repositories.title_accent"), class: "box-decoration-clone rounded-[10px] bg-lime px-[0.15em] dark:text-forest")) %></h1>
      <p class="max-w-[460px] text-lg leading-[1.55] text-forest-active dark:text-forest-soft"><%= t("home.no_repositories.body") %></p>
      <%= render Atoms::LinkButton::Component.new(href: new_repository_path, variant: :primary, size: :xl, class: "mt-1.5") do %><%= t("home.no_repositories.action") %><% end %>
    </section>
  <% else %>
    <h1 class="sr-only"><%= t(".title") %></h1>

    <% if workspace.banner_problem %>
      <%= render Molecules::ConfigBanner::Component.new(problem: workspace.banner_problem) %>
    <% end %>

    <%= render Organisms::InboxList::Component.new(items: workspace.items, preview: workspace.placeholder?, assign_href: (workspace.assign_issue_repository ? repository_section_path(workspace.assign_issue_repository.username, workspace.assign_issue_repository.slug, :issues) : user_repositories_path(Current.user.username)), repositories_href: user_repositories_path(Current.user.username)) %>

    <% if workspace.runs.any? %>
      <%= render Organisms::InProgress::Component.new(runs: workspace.runs, preview: workspace.placeholder?) %>
    <% end %>
  <% end %>
</div>
