<% content_for :main_class, "flex w-full flex-col" %>
<%= render Molecules::PageHeader::Component.new(title: t(".title"), icon: :key_round, class: "mb-10") do |header| %>
  <% header.with_aside do %>
    <%= render Atoms::LinkButton::Component.new(href: new_access_token_path, variant: :primary, size: :md) do %><%= render Atoms::Icon::Component.new(name: :plus, class: "size-[18px]", "stroke-width": 2) %><%= t(".new") %><% end %>
  <% end %>
<% end %>

<div class="flex w-full max-w-[760px] flex-col gap-6">
  <% if notice = flash[:notice] %>
    <%= render Molecules::Notice::Component.new(tone: :notice, id: "notice") do %><%= notice %><% end %>
  <% end %>

  <% if @plain_token %>
    <div class="rounded-xl border-2 border-ink bg-lime-soft p-4 dark:border-forest dark:text-forest" id="plain_token">
      <p class="font-bold"><%= t(".copy_now") %></p>
      <code class="mt-2 block break-all font-mono text-[13px] select-all"><%= @plain_token %></code>
    </div>
  <% end %>

  <% if @access_tokens.empty? %>
    <p class="border-t border-line pt-6 text-muted"><%= t(".empty") %></p>
  <% else %>
    <ul class="m-0 flex list-none flex-col border-t border-line p-0">
      <% @access_tokens.each do |access_token| %>
        <li class="flex items-center justify-between gap-4 border-b border-line py-5" id="<%= dom_id(access_token) %>">
          <div class="flex min-w-0 flex-col gap-0.5">
            <p class="text-[17px] font-bold"><%= access_token.name %></p>
            <p class="text-sm text-muted">
              <%= access_token.scopes.map { |scope| t("access_tokens.scopes.#{scope}") }.to_sentence %>
            </p>
            <p class="text-sm text-muted">
              <%= access_token.last_used_at ? t(".last_used", time: l(access_token.last_used_at, format: :short)) : t(".never_used") %>
              <% if access_token.expires_at %>
                &middot; <%= t(".expires", time: l(access_token.expires_at, format: :short)) %>
              <% end %>
            </p>
          </div>
          <% if access_token.revoked? %>
            <%= render Atoms::Chip::Component.new do %><%= t(".revoked") %><% end %>
          <% elsif access_token.expired? %>
            <%= render Atoms::Chip::Component.new do %><%= t(".expired") %><% end %>
          <% else %>
            <%= button_to t(".revoke"), access_token_path(access_token), method: :delete, class: "nb-btn h-10 bg-transparent px-3.5 text-sm text-danger hover:bg-danger-soft" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= render Atoms::Link::Component.new(href: root_path, tone: :underline, class: "self-start text-[15px]") do %><%= t(".back") %><% end %>
</div>
