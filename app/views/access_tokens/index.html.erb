<div class="nb-card mx-auto w-full bg-white p-6 md:w-2/3 md:p-8">
  <% if notice = flash[:notice] %>
    <p class="nb-card mb-5 bg-sky-100 px-4 py-2.5 font-bold text-sky-700" id="notice"><%= notice %></p>
  <% end %>

  <% if @plain_token %>
    <div class="nb-card mb-5 bg-sun-100 p-4" id="plain_token">
      <p class="font-bold"><%= t(".copy_now") %></p>
      <code class="block mt-2 break-all select-all"><%= @plain_token %></code>
    </div>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="text-4xl font-extrabold tracking-tight"><%= t(".title") %></h1>
    <%= link_to t(".new"), new_access_token_path, class: "nb-btn nb-btn-raised bg-brand-600 px-4 py-2.5 text-sm text-white hover:bg-brand-700" %>
  </div>

  <% if @access_tokens.empty? %>
    <p class="my-8 text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <ul class="my-8 divide-y divide-line">
      <% @access_tokens.each do |access_token| %>
        <li class="py-4 flex items-center justify-between gap-4" id="<%= dom_id(access_token) %>">
          <div>
            <p class="font-bold"><%= access_token.name %></p>
            <p class="text-sm text-ink-soft">
              <%= access_token.scopes.map { |scope| t("access_tokens.scopes.#{scope}") }.to_sentence %>
            </p>
            <p class="text-sm text-ink-soft">
              <%= access_token.last_used_at ? t(".last_used", time: l(access_token.last_used_at, format: :short)) : t(".never_used") %>
              <% if access_token.expires_at %>
                &middot; <%= t(".expires", time: l(access_token.expires_at, format: :short)) %>
              <% end %>
            </p>
          </div>
          <% if access_token.revoked? %>
            <span class="text-sm text-ink-soft"><%= t(".revoked") %></span>
          <% elsif access_token.expired? %>
            <span class="text-sm text-ink-soft"><%= t(".expired") %></span>
          <% else %>
            <%= button_to t(".revoke"), access_token_path(access_token), method: :delete, class: "font-bold text-coral-700 underline cursor-pointer" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to t(".back"), root_path, class: "font-bold text-brand-600 underline hover:no-underline" %>
</div>
