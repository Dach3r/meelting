<div class="mx-auto md:w-2/3 w-full">
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% if @plain_token %>
    <div class="p-4 mb-5 bg-yellow-50 rounded-lg" id="plain_token">
      <p class="font-medium"><%= t(".copy_now") %></p>
      <code class="block mt-2 break-all select-all"><%= @plain_token %></code>
    </div>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <%= link_to t(".new"), new_access_token_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @access_tokens.empty? %>
    <p class="my-8 text-gray-500"><%= t(".empty") %></p>
  <% else %>
    <ul class="my-8 divide-y divide-gray-200">
      <% @access_tokens.each do |access_token| %>
        <li class="py-4 flex items-center justify-between gap-4" id="<%= dom_id(access_token) %>">
          <div>
            <p class="font-medium"><%= access_token.name %></p>
            <p class="text-sm text-gray-500">
              <%= access_token.scopes.map { |scope| t("access_tokens.scopes.#{scope}") }.to_sentence %>
            </p>
            <p class="text-sm text-gray-500">
              <%= access_token.last_used_at ? t(".last_used", time: l(access_token.last_used_at, format: :short)) : t(".never_used") %>
              <% if access_token.expires_at %>
                &middot; <%= t(".expires", time: l(access_token.expires_at, format: :short)) %>
              <% end %>
            </p>
          </div>
          <% if access_token.revoked? %>
            <span class="text-sm text-gray-500"><%= t(".revoked") %></span>
          <% elsif access_token.expired? %>
            <span class="text-sm text-gray-500"><%= t(".expired") %></span>
          <% else %>
            <%= button_to t(".revoke"), access_token_path(access_token), method: :delete, class: "text-red-600 underline cursor-pointer" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to t(".back"), root_path, class: "text-gray-700 underline hover:no-underline" %>
</div>
