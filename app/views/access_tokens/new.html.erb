<div class="nb-card mx-auto w-full bg-white p-6 md:w-2/3 md:p-8">
  <h1 class="text-4xl font-extrabold tracking-tight"><%= t(".title") %></h1>

  <%= form_with model: @access_token, class: "contents" do |form| %>
    <% if @access_token.errors.any? %>
      <div class="nb-card mt-5 bg-coral-100 px-4 py-2.5 font-bold text-coral-700" id="error_explanation">
        <ul>
          <% @access_token.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="my-5">
      <%= form.label :name, class: "font-bold" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "nb-field" %>
    </div>

    <fieldset class="my-5">
      <legend class="font-bold"><%= AccessToken.human_attribute_name(:scopes) %></legend>
      <% AccessToken::SCOPES.each do |scope| %>
        <div class="mt-2">
          <%= check_box_tag "access_token[scopes][]", scope, @access_token.scopes.include?(scope), id: "access_token_scopes_#{scope}", class: "accent-brand-600" %>
          <%= label_tag "access_token_scopes_#{scope}", t("access_tokens.scopes.#{scope}") %>
        </div>
      <% end %>
    </fieldset>

    <div class="my-5">
      <%= form.label :expires_at, class: "font-bold" %>
      <%= form.datetime_field :expires_at, class: "nb-field" %>
      <p class="text-sm text-ink-soft mt-1"><%= t(".expires_hint") %></p>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit t(".submit"), class: "nb-btn nb-btn-raised bg-brand-600 px-5 py-3 text-white hover:bg-brand-700" %>
      <%= link_to t(".cancel"), access_tokens_path, class: "font-bold text-brand-600 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
