<% content_for :main_class, "flex w-full flex-col" %>
<%= render Molecules::PageHeader::Component.new(title: t(".title"), icon: :key_round, class: "mb-10") %>

<%= form_with model: @access_token, class: "flex w-full max-w-[600px] flex-col gap-6" do |form| %>
  <% if @access_token.errors.any? %>
    <%= render Molecules::Notice::Component.new(tone: :alert, id: "error_explanation") do %>
      <ul>
        <% @access_token.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <div>
    <%= form.label :name, class: "text-[15px] font-bold" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "off", class: "nb-field" %>
  </div>

  <fieldset>
    <legend class="text-[15px] font-bold"><%= AccessToken.human_attribute_name(:scopes) %></legend>
    <% AccessToken::SCOPES.each do |scope| %>
      <div class="mt-3 flex items-center gap-2.5">
        <%= check_box_tag "access_token[scopes][]", scope, @access_token.scopes.include?(scope), id: "access_token_scopes_#{scope}", class: "size-[18px] accent-forest dark:accent-lime" %>
        <%= label_tag "access_token_scopes_#{scope}", t("access_tokens.scopes.#{scope}"), class: "text-base" %>
      </div>
    <% end %>
  </fieldset>

  <div>
    <%= form.label :expires_at, class: "text-[15px] font-bold" %>
    <%= form.datetime_field :expires_at, autocomplete: "off", class: "nb-field" %>
    <p class="mt-2 text-sm text-muted"><%= t(".expires_hint") %></p>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit t(".submit"), class: "nb-btn h-14 flex-1 bg-forest px-6 text-[17px] text-lime hover:bg-forest-active" %>
    <%= render Atoms::LinkButton::Component.new(href: access_tokens_path, variant: :secondary, size: :lg) do %><%= t(".cancel") %><% end %>
  </div>
<% end %>
