<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <%= form_with model: @access_token, class: "contents" do |form| %>
    <% if @access_token.errors.any? %>
      <div class="py-2 px-3 bg-red-50 mt-5 text-red-500 font-medium rounded-lg" id="error_explanation">
        <ul>
          <% @access_token.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="my-5">
      <%= form.label :name, class: "font-medium" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <fieldset class="my-5">
      <legend class="font-medium"><%= AccessToken.human_attribute_name(:scopes) %></legend>
      <% AccessToken::SCOPES.each do |scope| %>
        <div class="mt-2">
          <%= check_box_tag "access_token[scopes][]", scope, @access_token.scopes.include?(scope), id: "access_token_scopes_#{scope}" %>
          <%= label_tag "access_token_scopes_#{scope}", t("access_tokens.scopes.#{scope}") %>
        </div>
      <% end %>
    </fieldset>

    <div class="my-5">
      <%= form.label :expires_at, class: "font-medium" %>
      <%= form.datetime_field :expires_at, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p class="text-sm text-gray-500 mt-1"><%= t(".expires_hint") %></p>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit t(".submit"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= link_to t(".cancel"), access_tokens_path, class: "text-gray-700 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
