<div>
  <button type="button" class="flex h-[46px] w-full cursor-pointer items-center gap-3.5 rounded-xl px-4 text-left text-[15px] font-semibold text-forest-soft hover:bg-forest-active/50 aria-expanded:text-white" aria-expanded="<%= expanded %>" aria-controls="<%= panel_id %>" data-sidebar-target="toggle" data-slug="<%= repository.slug %>" data-action="sidebar#toggle">
    <span class="flex size-[26px] shrink-0 items-center justify-center rounded-lg bg-forest-active text-xs font-bold text-lime" aria-hidden="true"><%= monogram %></span>
    <span class="min-w-0 flex-1 truncate"><%= repository.name %></span>
    <%= render Atoms::StatusDot::Component.new(tone: MIRROR_TONES.fetch(repository.mirror), label: t("sidebar.mirror.#{repository.mirror}")) %>
  </button>
  <div id="<%= panel_id %>" class="mt-0.5 mb-1.5 ml-[28px] flex flex-col gap-px border-l-2 border-forest-active pl-3" <%= "hidden" unless expanded %>>
    <% SECTIONS.each do |section| %>
      <% current = current_section?(section) %>
      <%= link_to t("sidebar.sections.#{section}"), section_path(section), class: class_names("flex h-9 items-center rounded-lg px-3 text-sm font-medium", current ? "bg-forest-active text-lime" : "text-forest-soft hover:bg-forest-active/50"), aria: { current: (current ? "page" : nil) } %>
    <% end %>
  </div>
</div>
