<div>
  <button type="button" class="group flex w-full cursor-pointer items-center gap-2.5 rounded-full px-3.5 py-2.5 text-left font-medium text-graphite-700 hover:bg-white/60 aria-expanded:font-semibold aria-expanded:text-graphite-900" aria-expanded="<%= expanded %>" aria-controls="<%= panel_id %>" data-sidebar-target="toggle" data-slug="<%= repository.slug %>" data-action="sidebar#toggle">
    <%= render Atoms::Icon::Component.new(name: :chevron_right, class: "size-4 shrink-0 transition-transform group-aria-expanded:rotate-90") %>
    <span class="min-w-0 flex-1 truncate"><%= repository.name %></span>
    <%= render Atoms::StatusDot::Component.new(tone: MIRROR_TONES.fetch(repository.mirror), label: t("sidebar.mirror.#{repository.mirror}")) %>
  </button>
  <div id="<%= panel_id %>" class="ml-[26px] mt-0.5 mb-1.5 flex flex-col gap-px border-l-2 border-graphite-100 pl-2.5" <%= "hidden" unless expanded %>>
    <% SECTIONS.each do |section| %>
      <%= link_to t("sidebar.sections.#{section}"), section_path(section), class: "rounded-full px-3.5 py-1.5 text-sm font-medium text-graphite-700 hover:bg-white/60" %>
    <% end %>
  </div>
</div>
