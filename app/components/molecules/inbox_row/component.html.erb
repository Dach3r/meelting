<li class="flex flex-wrap items-center gap-4 border-b border-line py-[18px]">
  <span class="<%= class_names("flex size-11 shrink-0 items-center justify-center rounded-xl", kind[:tile]) %>" aria-hidden="true">
    <%= render Atoms::Icon::Component.new(name: kind[:icon], class: "size-5", "stroke-width": 2) %>
  </span>
  <div class="min-w-0 flex-[1_1_260px]">
    <p class="truncate text-[17px] font-bold"><%= item.title %></p>
    <p class="mt-0.5 truncate text-sm text-forest"><%= context %></p>
  </div>
  <% if item.flag %>
    <%= render Atoms::StatusChip::Component.new(tone: :alert, icon: :triangle_alert) do %><%= t("home.inbox.flags.#{item.flag}") %><% end %>
  <% end %>
  <%= render Atoms::StatusChip::Component.new(tone: kind[:tone]) do %><%= t("home.inbox.kinds.#{item.kind}") %><% end %>
  <%= render Atoms::LinkButton::Component.new(href: href, variant: kind[:button], size: :md) do %><%= t("home.inbox.actions.#{item.kind}") %><% end %>
</li>
