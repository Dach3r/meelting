<div class="<%= class_names("relative flex min-h-[68px] items-center gap-3.5 rounded-[22px] px-5 py-3.5", selected ? "bg-sun-100" : "bg-white") %>">
  <% if item.issue? %>
    <%= render Atoms::Icon::Component.new(name: :circle_dot, class: "size-5 shrink-0 text-graphite-500") %>
  <% else %>
    <%= render Atoms::AgentAvatar::Component.new %>
  <% end %>

  <div class="min-w-0 flex-1">
    <% if href %>
      <%= link_to item.title, href, class: "block truncate font-bold tracking-[-0.01em] after:absolute after:inset-0 after:content-['']", data: { turbo_action: "replace" }, aria: { current: selected ? "true" : nil } %>
    <% else %>
      <p class="truncate font-bold tracking-[-0.01em]"><%= item.title %></p>
    <% end %>
    <p class="truncate text-[13px] leading-[1.4] text-graphite-500 <%= "font-mono" if item.running? %>"><%= subtitle %></p>
  </div>

  <% if chip || item.cost_cents %>
    <div class="flex shrink-0 flex-col items-end gap-1">
      <% if chip %>
        <%= render Atoms::StatusChip::Component.new(**chip) do %><%= chip_label %><% end %>
      <% end %>
      <% if item.cost_cents %>
        <span class="font-mono text-[13px] font-semibold text-graphite-700"><%= helpers.format_cents(item.cost_cents) %></span>
      <% end %>
    </div>
  <% end %>

  <% if unassigned? %>
    <%= render Atoms::PillButton::Component.new do %><%= render Atoms::Icon::Component.new(name: :bot, class: "size-4") %><%= t("home.actions.assign") %><% end %>
  <% end %>
</div>
