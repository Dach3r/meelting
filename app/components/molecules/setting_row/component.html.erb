<div class="group flex flex-wrap items-center gap-x-10 gap-y-3.5 py-6">
  <div class="min-w-0 max-w-90 flex-[1_1_16rem]">
    <%= content_tag label_tag_name, label, for: label_for, id: id, class: "text-[17px] font-bold text-ink" %>
    <% if hint? %>
      <p class="mt-1.5 text-[15px] leading-normal text-ink/65"><%= hint %></p>
    <% end %>
  </div>
  <div class="min-w-0 flex-[999_1_24rem]"><%= content %></div>
</div>
