<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div class="flex flex-col items-start gap-5">
    <%= render Atoms::Chip::Component.new(upper: true) do %><%= label %><% end %>
    <h2 class="text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] md:text-5xl">
      <%= title %><% if title_dim %><br><span class="text-brand-600"><%= title_dim %></span><% end %>
    </h2>
  </div>
  <% if aside %>
    <p class="max-w-sm text-ink-soft md:text-right"><%= aside %></p>
  <% end %>
</div>
