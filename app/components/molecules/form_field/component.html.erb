<div class="grid min-w-0 gap-1.5">
  <%= form.label attribute, label, class: "text-[13px] font-bold text-brand-100" %>
  <div class="nb-field-shell">
    <span class="nb-field-shell-icon"><%= render Atoms::Icon::Component.new(name: icon) %></span>
    <%= form.public_send(input, attribute, required: true, class: "nb-field-shell-input", **input_options) %>
  </div>
</div>
