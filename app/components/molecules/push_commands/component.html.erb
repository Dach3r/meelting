<div id="push_commands" class="mt-3 flex flex-col items-start gap-3">
  <pre class="w-full overflow-x-auto rounded-2xl bg-graphite-900 p-4 font-mono text-[13px] leading-relaxed text-white"><code class="select-all">git remote add <%= REMOTE %> <%= remote_url %>
git push -u <%= REMOTE %> <%= repository.default_branch %></code></pre>
  <% if token %>
    <p class="text-sm font-semibold text-graphite-900" role="status"><%= t("home.checklist.push.shown_once") %></p>
  <% else %>
    <%= render Atoms::Button::Component.new(href: repository_push_token_path(repository.slug), tone: :pill) do %><%= t("home.checklist.push.generate") %><% end %>
  <% end %>
</div>
