<div id="push_commands" class="mt-3 flex flex-col items-start gap-3">
  <pre class="w-full overflow-x-auto rounded-2xl bg-graphite-900 p-4 font-mono text-[13px] leading-relaxed text-white"><code class="select-all">git remote add origin <%= remote_url %>
git push -u origin <%= repository.default_branch %></code></pre>
  <% if token %>
    <div class="flex w-full flex-col gap-2 rounded-2xl bg-white p-4 text-sm text-graphite-900" id="push_token">
      <p class="font-semibold"><%= t("home.checklist.push.credentials") %></p>
      <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 font-mono text-[13px]">
        <dt class="text-graphite-500"><%= t("home.checklist.push.username") %></dt>
        <dd class="select-all"><%= username %></dd>
        <dt class="text-graphite-500"><%= t("home.checklist.push.password") %></dt>
        <dd class="select-all break-all"><%= token %></dd>
      </dl>
      <p class="text-graphite-500" role="status"><%= t("home.checklist.push.shown_once") %></p>
    </div>
  <% else %>
    <%= render Atoms::Button::Component.new(href: repository_push_token_path(repository.slug), tone: :pill) do %><%= t("home.checklist.push.generate") %><% end %>
  <% end %>
</div>
