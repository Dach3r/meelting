<div id="push_commands" class="mt-3 flex flex-col items-start gap-3">
  <pre class="w-full overflow-x-auto rounded-xl bg-forest p-4 font-mono text-[13px] leading-relaxed text-white"><code class="select-all">git remote add origin <%= remote_url %>
git push -u origin <%= repository.default_branch %></code></pre>
  <%= render Atoms::Button::Component.new(href: repository_push_token_path(repository.slug), tone: :pill) do %><%= t("home.checklist.push.generate") %><% end %>
  <% if access_token %>
    <dialog id="push_token" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-[28px] bg-white p-8 text-ink backdrop:bg-forest/70" aria-labelledby="push_token_title" closedby="none" data-controller="dialog">
      <h2 id="push_token_title" class="text-2xl leading-tight font-bold tracking-[-0.02em]"><%= t("home.checklist.push.modal_title") %></h2>
      <p class="mt-3 text-[15px] text-forest"><%= t("home.checklist.push.credentials") %></p>
      <div class="mt-6 flex flex-col gap-4">
        <% { username: username, password: access_token.plain_token }.each do |field, value| %>
          <div data-controller="clipboard" data-clipboard-copied-value="<%= t("home.checklist.push.copied") %>">
            <p class="mb-1.5 text-sm font-semibold text-forest"><%= t("home.checklist.push.#{field}") %></p>
            <div class="flex items-center gap-3 rounded-xl bg-forest py-2 pr-2 pl-4">
              <code class="min-w-0 flex-1 font-mono text-sm leading-relaxed break-all text-lime select-all" data-clipboard-target="source"><%= value %></code>
              <button type="button" class="h-9 shrink-0 cursor-pointer rounded-lg bg-lime px-3 text-sm font-bold text-forest hover:bg-lime-soft" data-action="clipboard#copy" data-clipboard-target="label"><%= t("home.checklist.push.copy") %></button>
            </div>
          </div>
        <% end %>
      </div>
      <div class="mt-6 rounded-xl bg-cream p-4">
        <p class="text-sm font-semibold text-forest"><%= t("home.checklist.push.permissions") %></p>
        <ul class="mt-2 flex flex-col gap-1.5 text-[15px]">
          <% access_token.scopes.each do |scope| %>
            <li class="flex items-center gap-2"><%= render Atoms::Icon::Component.new(name: :check, class: "size-4 shrink-0 text-forest") %><%= t("access_tokens.scopes.#{scope}") %></li>
          <% end %>
        </ul>
        <p class="mt-3 text-sm text-forest"><%= t("home.checklist.push.permissions_note_html", tokens: link_to(t("home.checklist.push.tokens_link"), access_tokens_path, class: "font-semibold underline")) %></p>
      </div>
      <p class="mt-5 text-sm font-semibold text-forest" role="status"><%= t("home.checklist.push.shown_once") %></p>
      <div class="mt-6 flex justify-end">
        <button type="button" class="inline-flex h-11 cursor-pointer items-center rounded-xl bg-forest px-6 text-[15px] font-bold text-lime hover:bg-forest-active" data-action="dialog#close"><%= t("home.checklist.push.accept") %></button>
      </div>
    </dialog>
  <% end %>
</div>
