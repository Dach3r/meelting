<section id="license_summary" class="flex flex-col gap-5 rounded-lg border border-line p-6">
  <div class="flex flex-col gap-1.5">
    <h2 class="flex items-center gap-2 text-[22px] font-bold tracking-[-0.01em]">
      <%= render Atoms::Icon::Component.new(name: :scale, class: "size-5 flex-none", "stroke-width": 2) %>
      <%= license.name %>
    </h2>
    <p class="text-[15px] text-muted"><%= license.description %></p>
  </div>
  <div class="grid gap-5 sm:grid-cols-3">
    <% license.rules.each do |group, tags| %>
      <div class="flex flex-col gap-2" data-group="<%= group %>">
        <h3 class="text-[13px] font-semibold tracking-wide text-muted/60 uppercase"><%= t("licenses.groups.#{group}") %></h3>
        <ul class="flex flex-col gap-1 text-[15px]">
          <% tags.each do |tag| %>
            <li><%= t("licenses.rules.#{group}.#{tag}") %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>
