<details class="relative">
  <summary class="<%= summary_classes %>" aria-label="<%= t("navbar.user_menu") %>">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-lime text-sm font-bold text-ink" aria-hidden="true"><%= initial %></span>
    <% unless compact %>
      <span class="min-w-0 flex-1 truncate text-base font-semibold"><%= user.full_name %></span>
      <%= render Atoms::Icon::Component.new(name: :chevrons_up_down, class: "size-4 shrink-0 text-forest-muted", "stroke-width": 2) %>
    <% end %>
  </summary>
  <div class="<%= panel_classes %>">
    <%= render Atoms::Link::Component.new(href: repositories_path, tone: :menu) do %><%= t("navbar.repositories") %><% end %>
    <%= render Atoms::Link::Component.new(href: access_tokens_path, tone: :menu) do %><%= t("navbar.access_tokens") %><% end %>
    <%= render Atoms::Button::Component.new(href: session_path, method: :delete, tone: :menu) do %><%= t("navbar.sign_out") %><% end %>
  </div>
</details>
