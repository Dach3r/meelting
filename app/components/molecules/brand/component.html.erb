<% if compact %>
  <%= link_to root_path, class: "inline-flex shrink-0 items-center text-[30px] leading-none font-bold #{tone[:brace]}", aria: { label: ApplicationHelper::APP_NAME } do %>
    <span aria-hidden="true" class="-translate-y-[0.06em]">{</span><span aria-hidden="true" class="mx-[0.07em] size-[0.42em] rounded-full <%= tone[:mark] %>"></span><span aria-hidden="true" class="-translate-y-[0.06em]">}</span>
  <% end %>
<% else %>
  <% before_i, after_i = name_parts %>
  <%= link_to root_path, class: "inline-flex shrink-0 items-baseline text-[26px] leading-none font-black tracking-[-0.035em] #{tone[:name]}", aria: { label: ApplicationHelper::APP_NAME } do %>
    <span aria-hidden="true" class="mr-[0.06em] font-semibold <%= tone[:brace] %>">{</span><span aria-hidden="true"><%= before_i %><span class="relative">ı<span class="absolute top-[0.21em] left-1/2 size-[0.2em] -translate-x-1/2 rounded-full <%= tone[:dot] %>"></span></span><%= after_i %></span><span aria-hidden="true" class="ml-[0.06em] font-semibold <%= tone[:brace] %>">}</span>
  <% end %>
<% end %>
