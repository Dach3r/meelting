<% before_i, after_i = name_parts %>
<%= link_to root_path, class: "inline-flex shrink-0 items-baseline text-xl leading-none font-black tracking-[-0.045em] #{tone[:name]}", aria: { label: ApplicationHelper::APP_NAME } do %>
  <span aria-hidden="true" class="mr-[0.02em] font-semibold <%= tone[:brace] %>">{</span><span aria-hidden="true"><%= before_i %><span class="bg-linear-to-b from-32% to-32% bg-clip-text text-transparent <%= tone[:dot] %>">i</span><%= after_i %></span><span aria-hidden="true" class="ml-[0.02em] font-semibold <%= tone[:brace] %>">}</span>
<% end %>
