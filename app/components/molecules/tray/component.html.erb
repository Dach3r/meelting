<%= tag.section **html_options do %>
  <div class="mb-4 flex flex-wrap items-baseline gap-3">
    <h2 class="text-[28px] leading-[1.1] font-extrabold tracking-[-0.02em]">
      <%= title %><% if count %> <span class="text-forest-muted"><%= count %></span><% end %>
    </h2>
    <% if preview %>
      <%= render Atoms::Chip::Component.new do %><%= preview %><% end %>
    <% end %>
    <% if link %>
      <%= link_to link[:label], link[:href], class: "ml-auto text-[15px] font-semibold text-muted hover:text-ink" %>
    <% end %>
  </div>
  <%= content_tag body_tag, content, class: "m-0 flex list-none flex-col gap-3 p-0" %>
<% end %>
