<div class="grid justify-items-center gap-3.5 text-center">
  <h1 class="text-balance text-[clamp(2rem,5vw,2.75rem)] font-extrabold leading-none tracking-[-0.045em]"><%= title %><% if title_dim %> <span class="text-graphite-400"><%= title_dim %></span><% end %></h1>
  <% if description %>
    <p class="text-sm leading-[1.4] text-graphite-500"><%= description %></p>
  <% end %>
</div>
