<div class="grid justify-items-center gap-3.5 text-center">
  <h1 class="text-balance text-[clamp(2rem,5vw,2.75rem)] leading-none font-extrabold tracking-[-0.03em]"><%= title %><% if title_dim %> <span class="text-forest/70"><%= title_dim %></span><% end %></h1>
  <% if description %>
    <p class="text-[15px] leading-[1.4] text-forest"><%= description %></p>
  <% end %>
</div>
