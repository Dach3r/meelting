<section id="self-host" class="mx-auto grid max-w-6xl scroll-mt-6 items-center gap-12 px-5 pb-20 md:grid-cols-2 md:pb-28">
  <div class="flex flex-col items-start gap-5">
    <%= render Atoms::Chip::Component.new(upper: true) do %><%= t("landing.open.label") %><% end %>
    <h2 class="text-4xl leading-[1.05] tracking-[-0.03em] md:text-5xl">
      <%= t("landing.open.title") %><br><span class="text-muted"><%= t("landing.open.title_dim") %></span>
    </h2>
    <p class="max-w-md text-muted"><%= t("landing.open.description") %></p>
    <dl class="mt-2 grid w-full grid-cols-3 gap-3">
      <% self.class::FACTS.each do |fact| %>
        <div class="rounded-ui border border-line bg-surface px-4 py-3.5">
          <dt class="text-lg font-bold tracking-tight"><%= t("landing.open.facts.#{fact}.value") %></dt>
          <dd class="text-sm text-muted"><%= t("landing.open.facts.#{fact}.label") %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%= render Molecules::Panel::Component.new(title: t("landing.open.terminal_title"), meta: t("landing.open.terminal_meta")) do %>
    <pre class="overflow-x-auto px-4 py-3 font-sans text-[13px] leading-7 text-muted"><span class="font-medium text-ink">$</span> docker compose up
<span class="text-accent">✓</span> <%= t("landing.open.ready") %>
<span class="font-medium text-ink">$</span> git clone https://berth.example.com/acme/api.git
<span class="text-accent">✓</span> <%= t("landing.open.cloned") %></pre>
  <% end %>
</section>
