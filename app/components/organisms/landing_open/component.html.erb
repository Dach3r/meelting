<section id="self-host" class="bg-dots-coral scroll-mt-6">
  <div class="nb-container grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
    <div class="flex flex-col items-start gap-5">
      <%= render Atoms::Chip::Component.new(upper: true) do %><%= t("landing.open.label") %><% end %>
      <h2 class="text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] md:text-5xl">
        <%= t("landing.open.title") %><br><span class="text-brand-600"><%= t("landing.open.title_dim") %></span>
      </h2>
      <p class="max-w-md text-ink-soft"><%= t("landing.open.description") %></p>
      <dl class="mt-2 grid w-full grid-cols-3 gap-3">
        <% self.class::FACTS.each do |fact| %>
          <div class="nb-card bg-white px-4 py-3.5">
            <dt class="text-lg font-extrabold tracking-tight"><%= t("landing.open.facts.#{fact}.value") %></dt>
            <dd class="text-sm text-ink-soft"><%= t("landing.open.facts.#{fact}.label") %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%= render Molecules::Panel::Component.new(title: t("landing.open.terminal_title"), meta: t("landing.open.terminal_meta")) do %>
      <pre class="overflow-x-auto px-4 py-3 font-sans text-[13px] leading-7 text-ink-soft"><span class="font-bold text-ink">$</span> docker compose up
<span class="font-bold text-brand-600">✓</span> <%= t("landing.open.ready") %>
<span class="font-bold text-ink">$</span> git clone https://berth.example.com/acme/api.git
<span class="font-bold text-brand-600">✓</span> <%= t("landing.open.cloned") %></pre>
    <% end %>
  </div>
</section>
