<div class="grid gap-4 sm:grid-cols-2">
  <%= render Molecules::Tray::Component.new(title: t("home.sections.repositories")) do %>
    <% inbox.repositories.each do |repository| %>
      <div class="flex min-h-14 items-center gap-3 rounded-[22px] bg-white px-5 py-3">
        <p class="min-w-0 flex-1 truncate font-bold"><%= repository.name %></p>
        <%= render Atoms::StatusChip::Component.new(tone: MIRROR_TONES.fetch(repository.mirror), icon: MIRROR_ICONS.fetch(repository.mirror)) do %><%= t("home.mirror.#{repository.mirror}", time: time_ago_in_words(repository.synced_at)) %><% end %>
      </div>
    <% end %>
  <% end %>

  <%= render Molecules::Tray::Component.new(title: t("home.sections.memory")) do %>
    <% if inbox.memory.empty? %>
      <p class="rounded-[22px] bg-white px-5 py-6 text-graphite-500"><%= t("home.empty.memory") %></p>
    <% end %>
    <% inbox.memory.each do |entry| %>
      <div class="flex min-h-14 items-center gap-3 rounded-[22px] bg-white px-5 py-3">
        <p class="min-w-0 flex-1 truncate font-mono text-xs"><%= entry.path %></p>
        <% if entry.proposed_in %>
          <%= render Atoms::StatusChip::Component.new(tone: :agent) do %><%= t("home.memory.proposed") %><% end %>
        <% else %>
          <span class="text-xs text-graphite-500"><%= time_ago_in_words(entry.touched_at) %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
