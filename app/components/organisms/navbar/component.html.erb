<nav class="fixed top-0 inset-x-0 z-10 h-16 border-b border-gray-200 bg-white" aria-label="<%= t("navbar.label") %>">
  <div class="container mx-auto flex h-full items-center justify-between px-5">
    <%= render Molecules::Brand::Component.new %>

    <div class="flex items-center gap-6">
      <% if authenticated %>
        <%= render Atoms::Link::Component.new(href: repositories_path) do %><%= t("navbar.repositories") %><% end %>
        <%= render Atoms::Link::Component.new(href: access_tokens_path) do %><%= t("navbar.access_tokens") %><% end %>
        <%= render Atoms::Button::Component.new(href: session_path, method: :delete) do %><%= t("navbar.sign_out") %><% end %>
      <% else %>
        <%= render Atoms::Link::Component.new(href: new_session_path) do %><%= t("navbar.sign_in") %><% end %>
        <%= render Atoms::Link::Component.new(href: new_registration_path) do %><%= t("navbar.sign_up") %><% end %>
      <% end %>
    </div>
  </div>
</nav>
