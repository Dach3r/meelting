<div class="lg:fixed lg:inset-y-0 lg:left-0 lg:z-30 lg:flex lg:w-23 lg:flex-col lg:group-data-sidebar-expanded/shell:w-66" data-controller="sidebar" data-sidebar-url-value="<%= sidebar_expansion_path %>" data-sidebar-cookie-value="<%= ApplicationHelper::SIDEBAR_COOKIE %>">
<div class="flex items-center justify-between px-5 pb-3 pt-6 lg:hidden">
  <%= render Molecules::Brand::Component.new(tone: :light) %>
  <button type="button" class="flex h-11 cursor-pointer items-center gap-2 rounded-xl bg-forest-active px-4 text-[15px] font-semibold text-white" aria-expanded="false" aria-controls="sidebar-menu" data-sidebar-target="menuButton" data-action="sidebar#menu">
    <%= t("sidebar.menu") %>
    <%= render Atoms::Icon::Component.new(name: :chevron_down, class: "size-4") %>
  </button>
</div>

<nav class="hidden h-full flex-col items-center py-[22px] lg:flex lg:group-data-sidebar-expanded/shell:hidden" aria-label="<%= t("sidebar.label") %>">
  <%= link_to root_path, class: "mt-3.5 mb-[34px] block size-[26px] rounded-full bg-lime", aria: { label: ApplicationHelper::CONFIG[:name] } do %><% end %>
  <div class="flex flex-col gap-2">
    <%= render Molecules::RailItem::Component.new(label: t("sidebar.inbox"), href: root_path, icon: :inbox, current: current_page_in?(root_path)) do |item| %>
      <% if workspace.inbox_count.positive? %>
        <% item.with_badge do %><span class="absolute top-[7px] right-3 h-4 min-w-4 rounded-full bg-lime px-1 text-center text-[11px] leading-4 font-bold text-forest" aria-label="<%= t("sidebar.inbox_pending", count: workspace.inbox_count) %>"><%= workspace.inbox_count %></span><% end %>
      <% end %>
    <% end %>
    <%= render Molecules::RailItem::Component.new(label: t("sidebar.runs"), href: runs_path, icon: :play, current: current_page_in?(runs_path)) do |item| %>
      <% if workspace.runs_count.positive? %>
        <% item.with_badge do %><span class="absolute top-3 right-[18px] flex"><%= render Atoms::StatusDot::Component.new(tone: :run, label: t("sidebar.runs_in_progress", count: workspace.runs_count)) %></span><% end %>
      <% end %>
    <% end %>
    <%= render Molecules::RailItem::Component.new(label: t("sidebar.repositories"), href: repositories_path, icon: :git_branch, current: current_page_in?(repositories_path)) %>
    <%= render Molecules::RailItem::Component.new(label: t("sidebar.new_repository"), href: new_repository_path, icon: :plus, current: current_page_in?(new_repository_path)) %>
    <%= render Molecules::RailItem::Component.new(label: t("sidebar.settings"), href: settings_path, icon: :settings, current: current_page_in?(settings_path)) do |item| %>
      <% if workspace.settings_warning? %>
        <% item.with_badge do %><span class="absolute top-3 right-[18px] flex"><%= render Atoms::StatusDot::Component.new(tone: :warn, label: t("sidebar.settings_warning")) %></span><% end %>
      <% end %>
    <% end %>
  </div>
  <button type="button" class="mt-auto flex size-11 cursor-pointer items-center justify-center rounded-xl text-forest-muted hover:bg-forest-active/50" aria-label="<%= t("sidebar.expand") %>" data-action="sidebar#expand">
    <%= render Atoms::Icon::Component.new(name: :chevrons_right, class: "size-5", "stroke-width": 1.75) %>
  </button>
</nav>

<nav id="sidebar-menu" class="hidden flex-col px-4 pb-6 data-open:flex lg:h-full lg:overflow-y-auto lg:py-[22px] lg:group-data-sidebar-expanded/shell:flex" aria-label="<%= t("sidebar.label") %>" data-sidebar-target="menu">
  <div class="mb-5 hidden h-[54px] items-center px-[18px] lg:flex">
    <%= render Molecules::Brand::Component.new(tone: :light) %>
  </div>
  <% if workspace.placeholder? %>
    <span class="mb-2 ml-4 self-start rounded-full border border-dashed border-forest-muted px-2.5 py-0.5 text-xs font-medium text-forest-soft"><%= t("sidebar.preview") %></span>
  <% end %>

  <div class="flex flex-col gap-1">
    <%= render Molecules::NavItem::Component.new(label: t("sidebar.inbox"), href: root_path, icon: :inbox, current: current_page_in?(root_path)) do |item| %>
      <% if workspace.inbox_count.positive? %>
        <% item.with_trailing do %><span class="h-[22px] min-w-[22px] rounded-full bg-lime px-[7px] text-center text-xs leading-[22px] font-bold text-forest" aria-label="<%= t("sidebar.inbox_pending", count: workspace.inbox_count) %>"><%= workspace.inbox_count %></span><% end %>
      <% end %>
    <% end %>

    <%= render Molecules::NavItem::Component.new(label: t("sidebar.runs"), href: runs_path, icon: :play, current: current_page_in?(runs_path)) do |item| %>
      <% if workspace.runs_count.positive? %>
        <% item.with_trailing do %><span class="flex items-center gap-1.5 font-mono text-xs font-semibold text-info-soft"><%= render Atoms::StatusDot::Component.new(tone: :run, label: t("sidebar.runs_in_progress", count: workspace.runs_count)) %><%= workspace.runs_count %></span><% end %>
      <% end %>
    <% end %>
  </div>

  <p class="mx-4 mt-6 mb-2 text-xs font-semibold tracking-[0.06em] text-forest-muted uppercase"><%= t("sidebar.repositories") %></p>
  <div class="flex flex-col gap-1">
    <% workspace.repositories.each do |repository| %>
      <%= render Molecules::SidebarRepository::Component.new(repository: repository, expanded: expanded?(repository)) %>
    <% end %>
    <%= render Molecules::NavItem::Component.new(label: t("sidebar.new_repository"), href: new_repository_path, icon: :plus, muted: true, compact: true, current: current_page_in?(new_repository_path)) %>
  </div>

  <div class="mt-auto flex flex-col gap-1 pt-8">
    <%= render Molecules::NavItem::Component.new(label: t("sidebar.settings"), href: settings_path, icon: :settings, current: current_page_in?(settings_path)) do |item| %>
      <% if workspace.settings_warning? %>
        <% item.with_trailing do %><%= render Atoms::StatusDot::Component.new(tone: :warn, label: t("sidebar.settings_warning")) %><% end %>
      <% end %>
    <% end %>
    <button type="button" class="hidden h-11 cursor-pointer items-center gap-3.5 rounded-xl px-4 text-left text-sm font-medium text-forest-muted hover:bg-forest-active/50 lg:flex" data-action="sidebar#collapse">
      <%= render Atoms::Icon::Component.new(name: :chevrons_left, class: "mx-px size-5 shrink-0", "stroke-width": 1.75) %>
      <span><%= t("sidebar.collapse") %></span>
    </button>
  </div>
</nav>
</div>
