<%= render Molecules::Tray::Component.new(title: t("home.in_progress.title"), preview: (t("home.preview_label") if preview), link: { label: t("home.in_progress.view_all"), href: runs_path }, list: true, id: "in-progress") do %>
  <% visible_runs.each do |run| %>
    <li class="flex flex-wrap items-center gap-4 rounded-xl border-2 border-ink py-3.5 pr-4 pl-3.5">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-lime text-forest" aria-hidden="true"><%= render Atoms::Icon::Component.new(name: :terminal, class: "size-[18px]", "stroke-width": 2) %></span>
      <div class="min-w-0 flex-[1_1_260px]">
        <p class="truncate text-base font-bold"><%= run.title %></p>
        <p class="mt-0.5 truncate font-mono text-[13px] text-muted"><%= run.last_event %></p>
      </div>
      <span class="inline-flex items-center gap-2 font-mono text-[13px] font-semibold text-ink"><span class="size-2 rounded-full bg-info" aria-hidden="true"></span><%= helpers.format_duration(run.elapsed_seconds) %></span>
    </li>
  <% end %>
<% end %>
