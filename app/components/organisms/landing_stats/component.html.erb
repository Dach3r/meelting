<section class="bg-dots-white">
  <div class="nb-container py-20 md:py-28">
    <dl class="grid grid-cols-2 gap-5 md:grid-cols-4">
      <% self.class::STATS.each_with_index do |stat, index| %>
        <div class="nb-card flex flex-col gap-1.5 p-6 <%= self.class::TINTS[index % self.class::TINTS.size] %>">
          <dt class="text-4xl font-extrabold leading-none tracking-[-0.04em] md:text-5xl"><%= t("landing.stats.#{stat}.value") %></dt>
          <dd class="text-sm font-medium text-ink-soft"><%= t("landing.stats.#{stat}.label") %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
