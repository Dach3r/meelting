<section class="mx-auto max-w-6xl px-5 pb-20 md:pb-28">
  <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-ui border border-line bg-line md:grid-cols-4">
    <% self.class::STATS.each do |stat| %>
      <div class="flex flex-col gap-1.5 bg-surface p-6">
        <dt class="text-4xl font-semibold leading-none tracking-[-0.04em] md:text-5xl"><%= t("landing.stats.#{stat}.value") %></dt>
        <dd class="text-sm text-muted"><%= t("landing.stats.#{stat}.label") %></dd>
      </div>
    <% end %>
  </dl>
</section>
