<div class="flex w-full flex-col gap-12 lg:flex-row lg:items-center lg:gap-16">
  <div class="flex w-full flex-col gap-8 lg:flex-[3]">
    <div>
      <h1 class="mb-3 text-5xl font-extrabold leading-none tracking-[-0.045em]"><%= t("home.checklist.title") %></h1>
      <p class="max-w-lg text-[17px] leading-relaxed text-graphite-500"><%= t("home.checklist.lead") %></p>
    </div>

    <ol class="m-0 flex list-none flex-col gap-2 p-0">
      <% steps.each_with_index do |step, index| %>
        <% is_current = step == current %>
        <li class="<%= class_names("flex flex-wrap items-center gap-5 rounded-3xl px-5", is_current ? "min-h-[72px] bg-sun-400 py-2 pr-3" : "min-h-[72px] py-2") %>" <%= 'aria-current=step' if is_current %>>
          <% if step.done %>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-graphite-900 text-sun-400" role="img" aria-label="<%= t("home.checklist.done") %>"><%= render Atoms::Icon::Component.new(name: :check, class: "size-4") %></span>
          <% else %>
            <span class="<%= class_names("flex size-10 shrink-0 items-center justify-center rounded-full font-mono text-[15px] font-semibold", is_current ? "bg-graphite-900 text-sun-400" : "border-[1.5px] border-graphite-100 text-graphite-500") %>" aria-hidden="true"><%= index + 1 %></span>
          <% end %>
          <div class="min-w-0 flex-[1_1_14rem]">
            <p class="<%= class_names("tracking-[-0.02em]", is_current ? "text-xl font-bold" : "text-lg font-semibold", "text-graphite-400 line-through" => step.done) %>"><%= title_for(step) %></p>
            <% if is_current && (detail = t("home.checklist.steps.#{step.key}.detail", default: "")).present? %>
              <p class="text-sm text-graphite-900/70"><%= detail %></p>
            <% end %>
          </div>
          <% if is_current && action_path(step) %>
            <%= render Atoms::LinkButton::Component.new(href: action_path(step), variant: :secondary, size: :pill) do %><%= t("home.checklist.steps.#{step.key}.action") %><% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </div>

  <div class="flex items-center justify-center lg:flex-[2] lg:pb-12">
    <div class="relative size-64 sm:size-80 xl:size-96">
      <svg viewBox="0 0 340 340" class="size-full" aria-hidden="true">
        <circle cx="170" cy="170" r="<%= RING_RADIUS %>" fill="none" stroke-width="28" class="stroke-graphite-50"/>
        <circle cx="170" cy="170" r="<%= RING_RADIUS %>" fill="none" stroke-width="28" stroke-linecap="round" stroke-dasharray="<%= ring_dash %> <%= RING_CIRCUMFERENCE %>" transform="rotate(-90 170 170)" class="stroke-sun-400"/>
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1" aria-hidden="true">
        <span class="text-8xl font-extrabold leading-[0.9] tracking-[-0.07em]"><%= done_count %></span>
        <span class="font-mono text-base text-graphite-500"><%= t("home.checklist.progress_of", total: steps.size) %></span>
      </div>
      <span class="sr-only" role="img"><%= t("home.checklist.progress", done: done_count, total: steps.size) %></span>
    </div>
  </div>
</div>
