<div class="flex w-full flex-col gap-12 lg:flex-row lg:items-center lg:gap-16">
  <div class="flex w-full min-w-0 flex-col gap-8 lg:flex-[3]">
    <div>
      <h1 class="mb-3 text-5xl leading-none font-extrabold tracking-[-0.03em]"><%= t("home.checklist.title") %></h1>
      <p class="max-w-lg text-[17px] leading-relaxed text-forest"><%= t("home.checklist.lead") %></p>
    </div>

    <ol class="m-0 flex list-none flex-col gap-2 p-0">
      <% steps.each_with_index do |step, index| %>
        <% is_current = step == current %>
        <li class="<%= class_names("flex min-h-[72px] flex-wrap items-center gap-5 rounded-xl border-2 border-transparent px-5 py-2", "border-ink bg-lime pr-3" => is_current, "opacity-60" => !step.available) %>" <%= 'aria-current=step' if is_current %> <%= 'aria-disabled=true' unless step.available %>>
          <% if step.done %>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-forest text-lime" role="img" aria-label="<%= t("home.checklist.done") %>"><%= render Atoms::Icon::Component.new(name: :check, class: "size-4") %></span>
          <% else %>
            <span class="<%= class_names("flex size-10 shrink-0 items-center justify-center rounded-full font-mono text-[15px] font-semibold", is_current ? "bg-forest text-lime" : "border-[1.5px] border-dashed text-forest") %>" aria-hidden="true"><%= index + 1 %></span>
          <% end %>
          <div class="min-w-0 flex-[1_1_14rem]">
            <p class="<%= class_names("font-display", is_current ? "text-xl font-bold" : "text-lg font-semibold", "text-forest/60 line-through" => step.done) %>"><%= title_for(step) %></p>
            <% if is_current && step.key == :repository %>
              <p class="text-sm text-forest"><%= t(repository ? "home.checklist.steps.repository.push_detail" : "home.checklist.steps.repository.detail") %></p>
              <% if repository %>
                <%= render Molecules::PushCommands::Component.new(repository: repository) %>
              <% end %>
            <% end %>
            <% if is_current && step.key == :model_key %>
              <p class="text-sm text-forest"><%= t("home.checklist.steps.model_key.detail") %></p>
            <% end %>
            <% if step.key == :overview && !step.done %>
              <details class="mt-1 text-sm">
                <summary class="cursor-pointer font-semibold text-forest"><%= t("home.checklist.steps.overview.template_label") %></summary>
                <pre class="mt-2 overflow-x-auto rounded-xl bg-cream p-4 font-mono text-[13px] leading-relaxed text-ink"><code class="select-all"><%= t("home.checklist.steps.overview.template") %></code></pre>
              </details>
            <% end %>
          </div>
          <% if is_current && step.key == :repository && repository.nil? %>
            <%= render Atoms::LinkButton::Component.new(href: new_repository_path, variant: :primary, size: :md) do %><%= t("home.checklist.steps.repository.action") %><% end %>
          <% end %>
          <% if is_current && step.key == :model_key %>
            <%= render Atoms::LinkButton::Component.new(href: new_provider_credential_path, variant: :primary, size: :md) do %><%= t("home.checklist.steps.model_key.action") %><% end %>
          <% end %>
          <% unless step.available %>
            <%= render Atoms::Chip::Component.new do %><%= t("home.checklist.steps.#{step.key}.unavailable") %><% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </div>

  <div class="flex items-center justify-center lg:flex-[2] lg:pb-12">
    <div class="relative size-64 sm:size-80 xl:size-96">
      <svg viewBox="0 0 340 340" class="size-full" aria-hidden="true">
        <circle cx="170" cy="170" r="<%= RING_RADIUS %>" fill="none" stroke-width="28" class="stroke-cream"/>
        <circle cx="170" cy="170" r="<%= RING_RADIUS %>" fill="none" stroke-width="28" stroke-linecap="round" stroke-dasharray="<%= ring_dash %> <%= RING_CIRCUMFERENCE %>" transform="rotate(-90 170 170)" class="stroke-lime"/>
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1" aria-hidden="true">
        <span class="font-display text-8xl leading-[0.9] font-extrabold tracking-[-0.05em]"><%= done_count %></span>
        <span class="font-mono text-base text-forest"><%= t("home.checklist.progress_of", total: steps.size) %></span>
      </div>
      <span class="sr-only" role="img"><%= t("home.checklist.progress", done: done_count, total: steps.size) %></span>
    </div>
  </div>
</div>
