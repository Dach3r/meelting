<div class="flex w-full flex-col">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <h1 class="mb-3 text-5xl leading-none font-extrabold tracking-[-0.03em]"><%= t("home.checklist.title") %></h1>
      <p class="max-w-[46ch] text-[17px] leading-relaxed text-forest"><%= t("home.checklist.lead") %></p>
    </div>
    <p class="text-[88px] leading-[0.85] font-black tracking-[-0.06em]" aria-hidden="true">
      <%= done_count %><span class="ml-1.5 text-lg font-medium tracking-normal text-forest"><%= t("home.checklist.progress_of", total: steps.size) %></span>
    </p>
    <span class="sr-only" role="img"><%= t("home.checklist.progress", done: done_count, total: steps.size) %></span>
  </div>

  <div class="relative mt-11 mb-7">
    <span class="absolute top-5 bottom-5 left-7 border-l-[3px] border-dashed border-cream-line lg:top-7 lg:right-[12.5%] lg:bottom-auto lg:left-[12.5%] lg:border-t-[3px] lg:border-l-0" aria-hidden="true"></span>
    <ol class="relative m-0 grid list-none grid-cols-1 gap-3.5 p-0 lg:grid-cols-4 lg:gap-0">
      <% steps.each_with_index do |step, index| %>
        <% is_current = step == current %>
        <li class="<%= class_names("flex items-center gap-3.5 lg:flex-col lg:gap-3 lg:px-2 lg:text-center", "opacity-60" => !step.available) %>" <%= 'aria-current=step' if is_current %> <%= 'aria-disabled=true' unless step.available %>>
          <% if step.done %>
            <span class="flex size-[60px] shrink-0 items-center justify-center rounded-full bg-forest text-lime" role="img" aria-label="<%= t("home.checklist.done") %>"><%= render Atoms::Icon::Component.new(name: :check, class: "size-5") %></span>
          <% else %>
            <span class="<%= class_names("flex size-[60px] shrink-0 items-center justify-center rounded-full font-mono text-lg font-semibold text-forest", is_current ? "border-4 border-forest bg-lime shadow-[0_0_0_8px_var(--color-lime-soft)]" : "border-2 border-dashed border-(--color-dashed) bg-white") %>" aria-hidden="true"><%= index + 1 %></span>
          <% end %>
          <div class="flex min-w-0 flex-col items-start gap-2 lg:items-center">
            <p class="<%= class_names("text-[15px]", is_current ? "font-extrabold" : "font-semibold", "text-forest/60 line-through" => step.done) %>"><%= title_for(step) %></p>
            <% unless step.available %>
              <%= render Atoms::Chip::Component.new do %><%= t("home.checklist.steps.#{step.key}.unavailable") %><% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </div>

  <% if current %>
    <section id="current_step" class="grid grid-cols-1 items-center gap-7 rounded-[20px] bg-lime p-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
      <div>
        <h2 class="mb-1.5 text-[26px] leading-tight font-bold tracking-[-0.02em]"><%= title_for(current) %></h2>
        <% if current.key == :repository %>
          <p class="text-sm text-forest"><%= t(repository ? "home.checklist.steps.repository.push_detail" : "home.checklist.steps.repository.detail") %></p>
        <% elsif current.key == :model_key %>
          <p class="text-sm text-forest"><%= t("home.checklist.steps.model_key.detail") %></p>
        <% end %>
      </div>
      <div class="flex min-w-0 flex-col items-start">
        <% if current.key == :repository %>
          <% if repository %>
            <%= render Molecules::PushCommands::Component.new(repository: repository) %>
          <% else %>
            <%= render Atoms::LinkButton::Component.new(href: new_repository_path, variant: :primary, size: :md) do %><%= t("home.checklist.steps.repository.action") %><% end %>
          <% end %>
        <% elsif current.key == :model_key %>
          <%= render Atoms::LinkButton::Component.new(href: new_provider_credential_path, variant: :primary, size: :md) do %><%= t("home.checklist.steps.model_key.action") %><% end %>
        <% elsif current.key == :overview %>
          <details class="w-full text-sm">
            <summary class="cursor-pointer font-semibold text-forest"><%= t("home.checklist.steps.overview.template_label") %></summary>
            <pre class="mt-2 overflow-x-auto rounded-xl bg-cream p-4 font-mono text-[13px] leading-relaxed text-ink"><code class="select-all"><%= t("home.checklist.steps.overview.template") %></code></pre>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
