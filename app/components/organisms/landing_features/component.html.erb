<section id="features" class="bg-dots-white scroll-mt-6">
  <div class="nb-container py-20 md:py-28">
    <%= render Molecules::SectionHeading::Component.new(
      label: t("landing.features.label"),
      title: t("landing.features.title"),
      title_dim: t("landing.features.title_dim"),
      aside: t("landing.features.aside")
    ) %>

    <div class="mt-12 grid gap-5 md:grid-cols-[1.3fr_1fr] md:grid-rows-2">
      <article class="nb-card flex flex-col gap-3 bg-brand-50 p-6 md:row-span-2">
        <span class="nb-chip size-10 justify-center bg-white p-0 text-brand-600"><%= render Atoms::Icon::Component.new(name: :layers) %></span>
        <h3 class="text-lg font-extrabold tracking-tight"><%= t("landing.features.memory.title") %></h3>
        <p class="text-ink-soft"><%= t("landing.features.memory.description") %></p>

        <div class="mt-3">
          <%= render Molecules::Panel::Component.new(title: t("landing.features.memory.panel"), meta: t("landing.features.memory.indexed")) do %>
            <div class="px-4 py-3 text-[13px] leading-7 text-ink-soft">
              <p class="font-bold text-ink">.project/</p>
              <p class="pl-4">overview.md</p>
              <p class="pl-4">architecture.md</p>
              <p class="pl-4">conventions.md</p>
              <p class="pl-4">known-issues.md</p>
              <p class="pl-4 font-bold text-ink">decisions/</p>
              <p class="pl-8"><span class="font-bold text-ink">0007-rate-limits.md</span> <span class="ml-2 rounded-md bg-sun-100 px-1.5 py-0.5 text-[11px] font-bold text-sun-700"><%= t("landing.features.memory.cited") %></span></p>
            </div>
            <div class="flex flex-col gap-0.5 border-t-nb border-ink px-4 py-3">
              <span class="font-bold"><%= t("landing.features.memory.decision_title") %></span>
              <span class="text-xs text-ink-soft"><%= t("landing.features.memory.decision_source") %></span>
            </div>
          <% end %>
        </div>
      </article>

      <article class="nb-card flex flex-col gap-3 bg-sun-100 p-6">
        <span class="nb-chip size-10 justify-center bg-white p-0 text-sun-700"><%= render Atoms::Icon::Component.new(name: :shield_check) %></span>
        <h3 class="text-lg font-extrabold tracking-tight"><%= t("landing.features.autonomy.title") %></h3>
        <p class="text-ink-soft"><%= t("landing.features.autonomy.description") %></p>
      </article>

      <article class="nb-card flex flex-col gap-3 bg-sky-100 p-6">
        <span class="nb-chip size-10 justify-center bg-white p-0 text-sky-700"><%= render Atoms::Icon::Component.new(name: :activity) %></span>
        <h3 class="text-lg font-extrabold tracking-tight"><%= t("landing.features.traceable.title") %></h3>
        <p class="text-ink-soft"><%= t("landing.features.traceable.description") %></p>
      </article>
    </div>
  </div>
</section>
