<section id="features" class="mx-auto max-w-6xl scroll-mt-6 px-5 pb-20 md:pb-28">
  <%= render Molecules::SectionHeading::Component.new(
    label: t("landing.features.label"),
    title: t("landing.features.title"),
    title_dim: t("landing.features.title_dim"),
    aside: t("landing.features.aside")
  ) %>

  <div class="mt-12 grid gap-4 md:grid-cols-[1.3fr_1fr] md:grid-rows-2">
    <article class="flex flex-col gap-3 rounded-ui border border-line bg-surface p-6 md:row-span-2">
      <span class="grid size-9 place-items-center rounded-ui bg-accent/10 text-accent"><%= render Atoms::Icon::Component.new(name: :memory) %></span>
      <h3 class="text-lg font-semibold tracking-tight"><%= t("landing.features.memory.title") %></h3>
      <p class="text-muted"><%= t("landing.features.memory.description") %></p>

      <div class="mt-3">
        <%= render Molecules::Panel::Component.new(title: t("landing.features.memory.panel"), meta: t("landing.features.memory.indexed")) do %>
          <div class="px-4 py-3 text-[13px] leading-7 text-muted">
            <p class="font-medium text-ink">.project/</p>
            <p class="pl-4">overview.md</p>
            <p class="pl-4">architecture.md</p>
            <p class="pl-4">conventions.md</p>
            <p class="pl-4">known-issues.md</p>
            <p class="pl-4 font-medium text-ink">decisions/</p>
            <p class="pl-8"><span class="font-medium text-ink">0007-rate-limits.md</span> <span class="ml-2 text-[11px] font-medium text-accent"><%= t("landing.features.memory.cited") %></span></p>
          </div>
          <div class="flex flex-col gap-0.5 border-t border-line px-4 py-3">
            <span class="font-semibold"><%= t("landing.features.memory.decision_title") %></span>
            <span class="text-xs text-muted"><%= t("landing.features.memory.decision_source") %></span>
          </div>
        <% end %>
      </div>
    </article>

    <article class="flex flex-col gap-3 rounded-ui border border-line bg-surface p-6">
      <span class="grid size-9 place-items-center rounded-ui bg-accent/10 text-accent"><%= render Atoms::Icon::Component.new(name: :shield) %></span>
      <h3 class="text-lg font-semibold tracking-tight"><%= t("landing.features.autonomy.title") %></h3>
      <p class="text-muted"><%= t("landing.features.autonomy.description") %></p>
    </article>

    <article class="flex flex-col gap-3 rounded-ui border border-line bg-surface p-6">
      <span class="grid size-9 place-items-center rounded-ui bg-accent/10 text-accent"><%= render Atoms::Icon::Component.new(name: :pulse) %></span>
      <h3 class="text-lg font-semibold tracking-tight"><%= t("landing.features.traceable.title") %></h3>
      <p class="text-muted"><%= t("landing.features.traceable.description") %></p>
    </article>
  </div>
</section>
