<section class="flex flex-1 flex-col justify-center gap-14 pb-10 sm:gap-16">
  <div class="grid justify-items-center gap-6 text-center">
    <h1 class="max-w-[860px] text-balance text-[clamp(2.75rem,6.6vw,5.25rem)] font-extrabold leading-none tracking-[-0.045em]">
      <%= t("landing.hero.title") %>
      <span class="text-graphite-400"><%= t("landing.hero.title_dim") %></span>
    </h1>
    <p class="max-w-[520px] text-[19px] leading-[1.4] text-graphite-500"><%= t("landing.hero.description", name: ApplicationHelper::CONFIG[:name]) %></p>
  </div>

  <ul class="mx-auto grid w-full max-w-[800px] gap-3">
    <% POINTS.zip(PILLS).each_with_index do |(point, pill), index| %>
      <li class="flex items-center gap-[18px] rounded-full py-3 pl-7 pr-3 <%= pill[:surface] %>">
        <h2 class="shrink-0 text-[22px] font-bold tracking-[-0.02em] sm:w-32"><%= t("landing.hero.points.#{point}.title") %></h2>
        <p class="min-w-0 flex-1 text-[15px] <%= pill[:text] %>"><%= t("landing.hero.points.#{point}.text") %></p>
        <span class="hidden h-3 w-60 shrink-0 overflow-hidden rounded-full sm:block <%= pill[:track] %>" aria-hidden="true">
          <span class="block h-full bg-sun-400 <%= pill[:fill] %>"></span>
        </span>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full font-extrabold <%= pill[:badge] %>" aria-hidden="true"><%= index + 1 %></span>
      </li>
    <% end %>
  </ul>
</section>
