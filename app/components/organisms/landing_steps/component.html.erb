<section class="bg-dots-sky">
  <div class="nb-container grid gap-12 py-20 md:grid-cols-2 md:py-28">
    <div class="flex flex-col items-start gap-5">
      <%= render Atoms::Chip::Component.new(upper: true) do %><%= t("landing.steps.label") %><% end %>
      <h2 class="text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] md:text-5xl">
        <%= t("landing.steps.title") %><br><span class="text-brand-600"><%= t("landing.steps.title_dim") %></span>
      </h2>
      <p class="max-w-md text-ink-soft"><%= t("landing.steps.description") %></p>
    </div>

    <ol>
      <% self.class::STEPS.each_with_index do |step, index| %>
        <li class="relative flex gap-4 pb-8 last:pb-0 after:absolute after:bottom-0 after:left-[17px] after:top-11 after:w-[1.5px] after:bg-ink last:after:hidden">
          <span class="nb-chip size-9 shrink-0 justify-center bg-sun-400 p-0 text-sm"><%= index + 1 %></span>
          <div>
            <h3 class="font-extrabold"><%= t("landing.steps.items.#{step}.title") %></h3>
            <p class="text-ink-soft"><%= t("landing.steps.items.#{step}.description") %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>
