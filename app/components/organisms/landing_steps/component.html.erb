<section class="border-y border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-2 md:py-28">
    <div class="flex flex-col items-start gap-5">
      <%= render Atoms::Chip::Component.new(upper: true) do %><%= t("landing.steps.label") %><% end %>
      <h2 class="text-4xl leading-[1.05] tracking-[-0.03em] md:text-5xl">
        <%= t("landing.steps.title") %><br><span class="text-muted"><%= t("landing.steps.title_dim") %></span>
      </h2>
      <p class="max-w-md text-muted"><%= t("landing.steps.description") %></p>
    </div>

    <ol>
      <% self.class::STEPS.each_with_index do |step, index| %>
        <li class="relative flex gap-4 pb-8 last:pb-0 after:absolute after:bottom-0 after:left-[13px] after:top-9 after:w-px after:bg-line last:after:hidden">
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-accent text-xs font-semibold text-white"><%= index + 1 %></span>
          <div>
            <h3 class="font-semibold"><%= t("landing.steps.items.#{step}.title") %></h3>
            <p class="text-muted"><%= t("landing.steps.items.#{step}.description") %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>
