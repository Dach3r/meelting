<section id="inbox" class="flex flex-col gap-5">
  <%= render Molecules::PageHeader::Component.new(title: t("home.inbox.title"), subtitle: (subtitle if items.any?), icon: :inbox, level: :h2) do |header| %>
    <% if preview && items.any? %>
      <% header.with_aside do %><%= render Atoms::Chip::Component.new do %><%= t("home.preview_label") %><% end %><% end %>
    <% end %>
  <% end %>
  <% if items.empty? %>
    <div class="flex flex-col items-center gap-2 border-t border-line px-6 pt-16 pb-8 text-center">
      <span class="mb-2 flex size-14 items-center justify-center rounded-xl bg-lime text-forest" aria-hidden="true"><%= render Atoms::Icon::Component.new(name: :check, class: "size-6", "stroke-width": 2) %></span>
      <h3 class="text-[22px] font-bold tracking-[-0.01em]"><%= t("home.inbox.empty.title") %></h3>
      <p class="mb-3 max-w-sm leading-relaxed text-forest"><%= t("home.inbox.empty.body") %></p>
      <%= render Atoms::LinkButton::Component.new(href: assign_href, variant: :primary, size: :md) do %><%= t("home.inbox.empty.action") %><% end %>
    </div>
  <% else %>
    <ul class="m-0 flex list-none flex-col border-t border-line p-0">
      <% items.each do |item| %>
        <%= render Molecules::InboxRow::Component.new(item: item, href: item_href(item)) %>
      <% end %>
    </ul>
  <% end %>
</section>
