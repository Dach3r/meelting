<% if items.empty? %>
  <%= render Molecules::Tray::Component.new(title: t("home.inbox.title"), id: "inbox") do %>
    <div class="flex flex-col items-center gap-2 rounded-[22px] bg-white px-6 py-16 text-center">
      <span class="mb-2 flex size-16 items-center justify-center rounded-[20px] bg-graphite-900 text-sun-400" aria-hidden="true"><%= render Atoms::Icon::Component.new(name: :check, class: "size-7") %></span>
      <h3 class="text-2xl font-extrabold tracking-[-0.04em]"><%= t("home.inbox.empty.title") %></h3>
      <p class="mb-3 max-w-sm leading-relaxed text-graphite-500"><%= t("home.inbox.empty.body") %></p>
      <%= render Atoms::LinkButton::Component.new(href: assign_href, variant: :primary, size: :pill) do %><%= t("home.inbox.empty.action") %><% end %>
    </div>
  <% end %>
<% else %>
  <%= render Molecules::Tray::Component.new(title: t("home.inbox.title"), count: items.size, preview: (t("home.preview_label") if preview), list: true, id: "inbox") do %>
    <% items.each do |item| %>
      <%= render Molecules::InboxRow::Component.new(item: item, href: item_href(item)) %>
    <% end %>
  <% end %>
<% end %>
