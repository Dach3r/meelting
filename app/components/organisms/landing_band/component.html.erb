<section class="mx-auto max-w-6xl px-5 pb-16">
  <div class="flex flex-col items-center gap-5 rounded-[8px] bg-accent px-6 py-14 text-center text-white md:py-16">
    <h2 class="max-w-xl text-4xl leading-[1.05] tracking-[-0.03em] text-balance md:text-5xl"><%= t("landing.band.title") %></h2>
    <p class="max-w-md text-white/80"><%= t("landing.band.description") %></p>
    <div class="flex flex-wrap justify-center gap-2">
      <%= render Atoms::LinkButton::Component.new(href: new_registration_path, variant: :inverse, size: :lg) do %><%= t("landing.band.primary") %><% end %>
      <%= render Atoms::LinkButton::Component.new(href: new_session_path, variant: :inverse_outline, size: :lg) do %><%= t("landing.band.secondary") %><% end %>
    </div>
  </div>
</section>
