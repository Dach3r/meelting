<section class="bg-dots-brand">
  <div class="nb-container flex flex-col items-center gap-5 py-16 text-center text-white md:py-20">
    <h2 class="max-w-xl text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] text-balance md:text-5xl"><%= t("landing.band.title") %></h2>
    <p class="max-w-md text-brand-100"><%= t("landing.band.description") %></p>
    <div class="flex flex-wrap justify-center gap-3">
      <%= render Atoms::LinkButton::Component.new(href: new_registration_path, variant: :inverse, size: :lg) do %><%= t("landing.band.primary") %><% end %>
      <%= render Atoms::LinkButton::Component.new(href: new_session_path, variant: :inverse_outline, size: :lg) do %><%= t("landing.band.secondary") %><% end %>
    </div>
  </div>
</section>
